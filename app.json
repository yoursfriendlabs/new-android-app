{
  "expo": {
    "name": "PM",
    "slug": "pasalmanager",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pasalmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yoursfriend.pasalmanager",
      "buildNumber": "2",
      "infoPlist": {
        "NSContactsUsageDescription": "PM uses your contacts so you can add people you pay or get paid by."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A2E20"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.yoursfriend.pasalmanager",
      "versionCode": 2,
      "permissions": [
        "READ_CONTACTS",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A2E20",
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0f1512",
            "image": "./assets/images/logo-mark.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "PM uses your contacts so you can add people you pay or get paid by."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-mark.png",
          "color": "#0A2E20",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PM uses your photos so you can add pictures of items, bills and your profile.",
          "cameraPermission": "PM uses your camera so you can take pictures of items, bills and your profile.",
          "microphonePermission": "PM uses the microphone only when you tap Pekka\u2019s mic to ask a question."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PM uses your location only when staff mark attendance, to confirm they are at the shop.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PM uses the microphone only when you tap Pekka\u2019s mic to ask a question.",
          "speechRecognitionPermission": "PM converts your spoken Pekka question into text using your device\u2019s speech service."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
