{
  "expo": {
    "name": "PM",
    "slug": "pasalmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pasalmanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yoursfriend.pasalmanager",
      "buildNumber": "1",
      "infoPlist": {
        "NSContactsUsageDescription": "PM uses your contacts so you can add people you pay or get paid by."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A2E20"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.yoursfriend.pasalmanager",
      "versionCode": 1,
      "permissions": [
        "READ_CONTACTS",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A2E20",
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "PM uses your contacts so you can add people you pay or get paid by."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-mark.png",
          "color": "#0A2E20",
          "sounds": [],
          "mode": "production"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
